# DynamicAPIRelay configuration. Copy to relay.env and fill in. Never commit real keys.

# Required: comma-separated id:secret pairs; each secret >= 32 bytes (e.g. `openssl rand -hex 32`).
RELAY_KEYS=client1:<generate-with-openssl-rand-hex-32>

RELAY_LISTEN_ADDR=127.0.0.1:8080
RELAY_MAX_REQUEST_BYTES=104857600
# 0 = unlimited
RELAY_MAX_RESPONSE_BYTES=0
RELAY_RATE_PER_SEC=30
RELAY_RATE_BURST=30
RELAY_MAX_CONCURRENT=20
RELAY_DIAL_TIMEOUT=10s
RELAY_TLS_HANDSHAKE_TIMEOUT=10s
RELAY_RESPONSE_HEADER_TIMEOUT=60s
RELAY_IDLE_CONN_TIMEOUT=90s
# 0 = unlimited (caps SSE/download session length when set)
RELAY_MAX_REQUEST_DURATION=0
RELAY_READ_HEADER_TIMEOUT=10s

# Usage dashboard / stats
RELAY_STATS_DB=./data/relay-stats.db
RELAY_STATS_RETENTION_DAYS=30
# Set to empty to disable the dashboard. Non-loopback addresses require a password.
RELAY_DASHBOARD_ADDR=127.0.0.1:8081
RELAY_DASHBOARD_PASSWORD=
RELAY_DASHBOARD_TZ=Asia/Shanghai
RELAY_TRUSTED_PROXIES=127.0.0.1/32,::1/128
