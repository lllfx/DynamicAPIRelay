# Public HTTPS entrypoint for DynamicAPIRelay.
# - flush_interval -1 disables response buffering so SSE events reach clients immediately.
# - Caddy sets X-Forwarded-For; the relay trusts it only from RELAY_TRUSTED_PROXIES (default 127.0.0.1/::1).
# - Keep any request_body max_size >= RELAY_MAX_REQUEST_BYTES.
# - Do NOT proxy the dashboard port (127.0.0.1:8081) through Caddy; use `ssh -L 8081:127.0.0.1:8081 <server>`.
relay.example.com {
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
	}
}
